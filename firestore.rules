rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // Helper Functions
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(resource) {
      return isAuthenticated() &&
             resource.data.ownerId == request.auth.uid;
    }

    function hasAccess(resource) {
      return isAuthenticated() && (
        // User is the owner
        resource.data.ownerId == request.auth.uid ||
        // OR user is in sharedWith array
        (resource.data.sharedWith != null &&
         request.auth.uid in resource.data.sharedWith)
      );
    }

    function canEdit(resource) {
      // Phase 8: All shared users have edit access (no view-only)
      return hasAccess(resource);
    }

    function isAdmin() {
      // Admin Analytics: Only allow specific admin user
      return isAuthenticated() &&
             request.auth.uid == 'HYqET9vr40eDju4nQCTnJTV0qJo2';
    }

    // ==========================================
    // User Profile
    // ==========================================

    // User document (users-v2/{userId})
    // Allow all authenticated users to read basic profile info for share dialogs
    match /users-v2/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && userId == request.auth.uid;
    }

    // User profile subcollection (legacy support if needed)
    match /users-v2/{userId}/profile/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && userId == request.auth.uid;
    }

    // ==========================================
    // Articles (Private to Owner)
    // ==========================================

    match /users-v2/{userId}/articles/{articleId} {
      // ADMIN: Allow admin to read all articles (for analytics collectionGroup queries)
      // IMPORTANT: Admin check must be FIRST, outside authentication wrapper
      // This ensures collectionGroup queries work for admin
      allow read: if isAdmin() || isAuthenticated();

      // Phase 8.2: Only owner can create/update/delete their own articles
      // Fixed: delete checks resource.data (existing), not request.resource.data (null)
      allow create, update: if isAuthenticated() &&
                              userId == request.auth.uid &&
                              request.resource.data.ownerId == request.auth.uid;

      allow delete: if isAuthenticated() &&
                      userId == request.auth.uid &&
                      resource.data.ownerId == request.auth.uid;
    }

    // ==========================================
    // Lists (Owner + Shared Users)
    // ==========================================

    match /users-v2/{userId}/lists/{listId} {
      // ADMIN: Admin can read all lists (for analytics collectionGroup queries)
      // IMPORTANT: Admin check must be FIRST, outside authentication wrapper
      // Regular users: Own lists OR lists shared with them
      allow read: if isAdmin() || (isAuthenticated() && (
        // Own lists in own path
        userId == request.auth.uid ||
        // Owner can read their lists anywhere (collection group queries)
        resource.data.ownerId == request.auth.uid ||
        // Shared lists (user is in sharedWith array - works for collection group queries)
        (resource.data.sharedWith != null && request.auth.uid in resource.data.sharedWith)
      ));

      // Update: Owner OR collaborator (with safety checks)
      allow update: if isAuthenticated() && (
        // Owner can update anything in their own path
        (userId == request.auth.uid && resource.data.ownerId == request.auth.uid) ||

        // Collaborators can update list content BUT cannot change ownership
        (resource.data.sharedWith != null &&
         request.auth.uid in resource.data.sharedWith &&
         request.resource.data.ownerId == resource.data.ownerId &&
         // Allow sharedWith changes ONLY if removing yourself
         (request.resource.data.sharedWith == resource.data.sharedWith ||
          (request.resource.data.sharedWith.size() == resource.data.sharedWith.size() - 1 &&
           !(request.auth.uid in request.resource.data.sharedWith) &&
           request.auth.uid in resource.data.sharedWith))) ||

        // Special case: Allow adding yourself to sharedWith (invite acceptance)
        (request.auth.uid in request.resource.data.sharedWith &&
         !(request.auth.uid in resource.data.sharedWith) &&
         request.resource.data.ownerId == resource.data.ownerId) ||

        // Owner can remove collaborators (updating in own path)
        (userId == resource.data.ownerId &&
         request.auth.uid == resource.data.ownerId &&
         request.resource.data.ownerId == resource.data.ownerId)
      );

      // Create: Only in own user path, must set ownerId
      allow create: if isAuthenticated() &&
                       userId == request.auth.uid &&
                       request.resource.data.ownerId == request.auth.uid;

      // Delete: Only owner can delete
      allow delete: if isOwner(resource);
    }

    // ==========================================
    // Unshare Notifications
    // ==========================================

    match /users-v2/{userId}/unshare-notifications/{notificationId} {
      allow read: if isAuthenticated() && userId == request.auth.uid;
      allow write: if isAuthenticated() && userId == request.auth.uid;
    }

    // ==========================================
    // Share Invites (Global Collection)
    // Phase 8: Token-based invites
    // ==========================================

    match /share-invites/{inviteId} {
      // Can read if you created it or if you're authenticated (need token anyway)
      allow read: if isAuthenticated();

      // Can create if you're authenticated and you're the sender
      allow create: if isAuthenticated() &&
        request.resource.data.fromUserId == request.auth.uid;

      // Can update to accept invite (mark as accepted)
      allow update: if isAuthenticated() &&
        resource.data.status == 'pending';

      // Can delete if you created it
      allow delete: if isAuthenticated() &&
        resource.data.fromUserId == request.auth.uid;
    }

    // ==========================================
    // Legacy Path (Temporary - Remove Later)
    // ==========================================

    match /users/{userId}/{document=**} {
      allow read, write: if userId == 'shared-shoplisl-user';
    }

    // ==========================================
    // Analytics Collections (Admin Only)
    // ==========================================

    // Raw analytics events (short-term storage, 90-day retention)
    match /analytics/events/items/{eventId} {
      allow read: if isAdmin();
      allow write: if isAuthenticated(); // All users can write events
    }

    // Daily aggregated metrics
    match /analytics/daily-aggregates/{date} {
      allow read: if isAdmin();
      allow write: if isAdmin(); // Only admin can write aggregates
    }

    // Per-user metrics (cached)
    match /analytics/user-metrics/{userId} {
      allow read: if isAdmin();
      allow write: if isAuthenticated(); // Users can update their own metrics
    }

    // AI-specific insights
    match /analytics/ai-insights/{date} {
      allow read: if isAdmin();
      allow write: if isAuthenticated(); // AI service writes insights
    }

    // ==========================================
    // Admin Collections (Admin Only)
    // ==========================================

    // Feature flags
    match /admin/feature-flags/{flagId} {
      allow read: if isAuthenticated(); // All users can read flags
      allow write: if isAdmin(); // Only admin can modify flags
    }

    // User feedback
    match /admin/user-feedback/{feedbackId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin(); // Only admin can update feedback status
      allow delete: if isAdmin();
    }

    // System alerts
    match /admin/system-alerts/{alertId} {
      allow read, write: if isAdmin();
    }

    // ==========================================
    // Default Deny
    // ==========================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}