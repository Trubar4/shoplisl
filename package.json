{
  "name": "shoplisl-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:karma": "ng test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "serve:pwa": "ng build && npx http-server dist/shoplisl-app -p 8080",
    "firebase:emulator": "firebase emulators:start",
    "i18n:extract": "ng extract-i18n",
    "backup:firestore": "ts-node scripts/backup-firestore.ts",
    "backup:full": "ts-node scripts/full-backup-firestore.ts",
    "backup:full:latest": "ts-node scripts/full-backup-firestore.ts -- --latest",
    "restore:firestore": "ts-node scripts/restore-firestore.ts",
    "restore:backup": "ts-node scripts/restore-from-backup.ts",
    "restore:specific": "node --loader ts-node/esm scripts/restore-specific-lists.ts",
    "diagnose:sharing": "ts-node scripts/diagnose-sharing.ts",
    "diagnose:counts": "ts-node scripts/diagnose-article-count-issue.ts",
    "check:lists": "node --loader ts-node/esm scripts/check-list-state.ts",
    "create-test-users": "node --loader ts-node/esm scripts/create-test-users.ts",
    "cleanup:temp-ids": "ts-node scripts/cleanup-legacy-temp-ids.ts",
    "cleanup:temp-ids:execute": "ts-node scripts/cleanup-legacy-temp-ids.ts --execute --backup",
    "inspect:lists": "ts-node scripts/inspect-affected-lists.ts",
    "recover:lists": "ts-node scripts/recover-list-data.ts",
    "migrate:old-backup": "ts-node scripts/migrate-from-old-backup.ts --dry-run",
    "migrate:old-backup:execute": "ts-node scripts/migrate-from-old-backup.ts --execute"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.0.0",
    "@angular/cdk": "^20.0.1",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "^20.0.0",
    "@angular/material": "^20.0.1",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-browser-dynamic": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@angular/service-worker": "^20.0.0",
    "@ngrx/effects": "^20.1.0",
    "@ngrx/entity": "^20.1.0",
    "@ngrx/store": "^20.1.0",
    "@ngrx/store-devtools": "^20.1.0",
    "firebase": "^11.8.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@angular/localize": "^20.0.0",
    "@playwright/test": "^1.57.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^25.0.8",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "firebase-admin": "^13.6.0",
    "firebase-tools": "^14.5.1",
    "jasmine-core": "~5.7.0",
    "jsdom": "^27.0.1",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "playwright": "^1.57.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.2",
    "vitest": "^3.2.4"
  }
}
